.env
.env.generated
*.log
# Where the capture writes. A finished set belongs in the plugin's own repository
# beside the readme that names it, so anything here is this checkout's scratch --
# including the refused render the driver keeps when a shot is rejected.
dist/

# Python's own cache. It caches a module it imports, not a file it is handed to
# run, so nothing in scripts/ writes here in ordinary use: the directory turns
# up when something loads one of them as a module instead, which is how a stray
# .pyc reaches a commit without anybody having seen it arrive.
__pycache__/

.DS_Store
.idea
.vscode
