# Copy to .env or export these in the shell.
# PLUGIN_PATH must be the plugin directory that contains the main plugin file.

PLUGIN_PATH=../due-date-for-woocommerce
PLUGIN_SLUG=due-date-for-woocommerce
WP_VERSION=latest
WC_VERSION=latest
PHP_VERSION=8.3
HPOS_MODE=enabled

# Optional second plugin (Core + Pro add-on)
# EXTRA_PLUGIN_PATH=../due-date-for-woocommerce-pro
# EXTRA_PLUGIN_SLUG=due-date-for-woocommerce-pro

# Optional
# WP_PORT=8080
# Timezone the install sets. Tests want one fixed value; screenshots want the
# timezone of the shop being photographed, and a seed sets its own regardless.
# WP_TIMEZONE=Europe/London
# PLUGIN_TEST_COMMAND=
# PC_SKIP_GENERIC_TESTS=0
# PC_SKIP_PLUGIN_TESTS=0
# GENERIC_TEST_WC_INACTIVE=1
# How long to wait for MariaDB. Match the health check budget in
# docker-compose.yml if you change either.
# PC_DB_WAIT_SECONDS=240
# Attempts at fetching an image the machine has not got, and the first wait
# between them; the wait doubles. Covers a registry that cannot be reached.
# PC_PULL_ATTEMPTS=1 turns the retry off.
# PC_PULL_ATTEMPTS=3
# PC_PULL_RETRY_SECONDS=10
